//@version=6
indicator("Plot styles", overlay=false)
r = ta.rsi(close, 14)
plot(r, "Columns", style=plot.style_columns, histbase=50, color=color.new(color.gray, 70))
plot(ta.sma(r, 10), "Area", style=plot.style_area, histbase=50, color=color.teal)
plot(r, "Step", style=plot.style_stepline, linewidth=3, offset=2, color=color.blue)
plot(ta.sma(r, 20), "Dots", style=plot.style_circles, linewidth=3, color=color.fuchsia)
hline(70, "Over", linestyle=hline.style_dashed, color=color.red)
hline(50, "Mid", linestyle=hline.style_dotted, linewidth=2, color=color.gray)
hline(30, "Under", linestyle=hline.style_solid, color=color.green)
plotshape(r < 30, "Low", style=shape.triangleup, location=location.bottom, color=color.green, text="Low", size=size.small)
plotshape(r > 60, "High", style=shape.triangledown, location=location.top, color=color.red, text="High", size=size.large)
plotchar(ta.crossunder(r, 50), "Down", char="X", location=location.top, color=#FFEB3B, size=size.huge)
plotchar(ta.crossover(r, 50), "Up", char="🚀", location=location.bottom, size=size.large)
