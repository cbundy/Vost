# Vost environment — copy to `.env` (docker compose / local runs).

# ---- server (runtime) ----------------------------------------------------
# Port the Node server listens on.
PORT=8787

# Bind address. Use 127.0.0.1 when a reverse proxy (nginx, caddy, traefik)
# sits in front; 0.0.0.0 to expose directly.
HOST=0.0.0.0

# Seconds between the server's background health checks of each exchange (the
# top-bar connection light, GET /api/status). 0 turns the checks off.
# VOST_STATUS_INTERVAL=60

# Folder for alerts.json, the one file the server writes (price alerts).
# Default: ./data next to the repo; the Docker image uses /data.
# VOST_DATA_DIR=./data

# Seconds between price polls for alerts on providers without a live feed
# (Coinbase, Yahoo, Stooq). Minimum 10.
# VOST_ALERT_POLL=60

# Telegram message for every alert that fires. Both must be set, else nothing
# is sent. The token is a secret: keep it out of logs, tickets and git.
# Token: talk to @BotFather, /newbot. Chat id: message your bot, then open
# https://api.telegram.org/bot<token>/getUpdates and read message.chat.id.
# VOST_TELEGRAM_BOT_TOKEN=
# VOST_TELEGRAM_CHAT_ID=

# ---- dev only -------------------------------------------------------------
# Where the Vite dev server proxies /api/* (default http://localhost:8787).
# VOST_SERVER_URL=http://localhost:8787
