# Vost environment — copy to `.env` (docker compose / local runs).

# ---- server (runtime) ----------------------------------------------------
# Port the Node server listens on.
PORT=8787

# Bind address. Use 127.0.0.1 when a reverse proxy (nginx, caddy, traefik)
# sits in front; 0.0.0.0 to expose directly.
HOST=0.0.0.0

# ---- dev only -------------------------------------------------------------
# Where the Vite dev server proxies /api/* (default http://localhost:8787).
# VOST_SERVER_URL=http://localhost:8787
